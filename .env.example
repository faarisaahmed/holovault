# Copy to .env for local overrides. None of these are needed to run locally:
# without DATABASE_URL the app uses an embedded Postgres in data/userdb.

# Hosted Postgres for accounts and collections (required in production).
# Neon's free tier works well: https://neon.tech
DATABASE_URL=

# Long random string that signs sessions (required in production).
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL of the site, e.g. https://card-tracker.onrender.com
BETTER_AUTH_URL=http://localhost:5173

# Optional: "Continue with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the redirect URI
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email verification and password reset, sent through Resend
# (https://resend.com). Without these, password accounts can't reset by email.
RESEND_API_KEY=
EMAIL_FROM="Holovault <vault@yourdomain.com>"

# Optional: the sibling Ripwise deployment, for PSA sold prices on the
# grading page, e.g. https://pull-tracker.onrender.com
RIPWISE_URL=
